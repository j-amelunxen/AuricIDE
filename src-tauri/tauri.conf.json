{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AuricIDE",
  "version": "0.1.0",
  "identifier": "com.auricide.ide",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:41873",
    "beforeDevCommand": "pnpm mcp:bundle && pnpm dev",
    "beforeBuildCommand": "pnpm mcp:bundle && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "AuricIDE",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 16 }
      }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../dynamic-providers": "dynamic-providers",
      "resources/auric-mcp": "auric-mcp"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {}
  }
}
