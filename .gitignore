# Local themes (user-supplied). README + *.example stay tracked; JSON is local-only.
themes/*.json

# Excalidraw runtime assets (copied from node_modules on install)
public/excalidraw-assets/

# CodeGraph local index
.codegraph/

# Generated promo/marketing assets (Higgsfield experiments) — keep out of the repo
promo-assets/

# Local tool notes — not repo content
workarounds/

# pnpm local package store (cache, never commit)
.pnpm-store/

# Local commit-guard state — machine-specific, not repo content
.commit-guard.json

# Design reviews, drafts and QA checklists — local working material, not repo docs
.design-review/
docs/actionplan-overlay-flows.md
docs/design-scheduled-skill-combo-notifications.md
docs/invariants-scheduled-skill-combo.md
