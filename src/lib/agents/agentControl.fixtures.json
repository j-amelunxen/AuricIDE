    "error": {
      "id": 5,
      "ok": false,
      "error": {
        "code": "headless_no_stdin",
        "message": "agent-2 runs headless and does not read input"
      }
    }
  },
  "invalidResponses": [
    {
      "name": "ok without result",
      "method": "kill",
      "raw": {
