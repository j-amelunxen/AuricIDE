{
  "_comment": [
    "The single source of truth for the agent-control socket protocol (docs/design-agent-control.md).",
    "Two implementations read this file: src-tauri/src/control_socket (cargo test, via include_str!)",
    "parses the requests and must produce responses of the shapes below; src/mcp/controlClient.ts",
    "(Vitest) builds the requests and validates every response against the same shapes, and the",
    "TS mock socket server answers with these responses. Add a case here before changing either side.",
    "Supervisor scope (ADR 0004): callerScope says which caller may use which method and what a supervisor caller is refused; additionalResponses holds the further valid answers a method can give."
  ],
  "errorCodes": [
    "invalid_request",
    "unknown_method",
    "invalid_params",
    "unknown_agent",
    "agent_not_running",
    "headless_no_stdin",
    "provider_denied",
    "frontend_unavailable",
    "forbidden_agent_caller",
    "supervisor_denied",
    "outside_supervisor_scope",
    "internal"
  ],
  "clientOnlyErrorCodes": ["app_not_running", "timeout", "contract_violation"],
  "limits": {
    "defaultTailBytes": 16384,
    "maxTailBytes": 262144,
    "bufferBytesPerAgent": 262144,
    "finishedAgentsKept": 20,
    "frontendTimeoutMs": 30000,
    "connectionIdleTimeoutMs": 60000,
    "defaultAwaitSeconds": 60,
    "maxAwaitSeconds": 120,
    "awaitClientGraceSeconds": 5,
    "inputQuietSeconds": 20,
    "runResultsKept": 200,
    "consoleTailAnswerBytes": 8192
  },
  "enter": "\r",
  "environment": {
    "ideAgentMarker": "AURIC_IDE_AGENT",
    "_comment": "Set to 1 on every agent process the IDE spawns (and so inherited by any MCP server that agent starts). auric-mcp --control refuses to start while it is set."
  },
  "events": {
    "controlRequest": "control-request",
    "agentInputSent": "agent-input-sent",
    "respondCommand": "control_respond",
    "readyCommand": "control_ready"
  },
  "spawnRefusals": [
    {
      "code": "provider_denied",
      "pattern": "is not permitted in this project",
      "sample": "Provider 'grok' is not permitted in this project. Its provider policy decides which agents may run here — change it under Settings → Project → Providers."
    },
    {
      "code": "invalid_params",
      "pattern": "is not installed in AuricIDE",
      "sample": "Provider 'nope' is not installed in AuricIDE. Import its config under Settings → Providers, or pick an installed one."
    }
  ],
  "requests": [
    {
      "name": "list_agents without params",
      "raw": "{\"id\":1,\"method\":\"list_agents\"}",
      "expected": {
        "id": 1,
        "method": "list_agents",
        "params": {}
      }
    },
    {
      "name": "string ids are echoed as strings",
      "raw": "{\"id\":\"a\",\"method\":\"list_projects\",\"params\":{}}",
      "expected": {
        "id": "a",
        "method": "list_projects",
        "params": {}
      }
    },
    {
      "name": "read_output defaults tailBytes",
      "raw": "{\"id\":2,\"method\":\"read_output\",\"params\":{\"agentId\":\"agent-1\"}}",
      "expected": {
        "id": 2,
        "method": "read_output",
        "params": {
          "agentId": "agent-1",
          "tailBytes": 16384,
          "sinceOffset": null
        }
      }
    },
    {
      "name": "read_output clamps tailBytes to the maximum",
      "raw": "{\"id\":3,\"method\":\"read_output\",\"params\":{\"agentId\":\"agent-1\",\"tailBytes\":999999999}}",
      "expected": {
        "id": 3,
        "method": "read_output",
        "params": {
          "agentId": "agent-1",
          "tailBytes": 262144,
          "sinceOffset": null
        }
      }
    },
    {
      "name": "read_output with sinceOffset",
      "raw": "{\"id\":4,\"method\":\"read_output\",\"params\":{\"agentId\":\"agent-1\",\"sinceOffset\":120}}",
      "expected": {
        "id": 4,
        "method": "read_output",
        "params": {
          "agentId": "agent-1",
          "tailBytes": 16384,
          "sinceOffset": 120
        }
      }
    },
    {
      "name": "send_input defaults enter to true",
      "raw": "{\"id\":5,\"method\":\"send_input\",\"params\":{\"agentId\":\"agent-2\",\"text\":\"hallo\"}}",
      "expected": {
        "id": 5,
        "method": "send_input",
        "params": {
          "agentId": "agent-2",
          "text": "hallo",
          "enter": true
        }
      }
    },
    {
      "name": "send_input empty text with enter is a nudge",
      "raw": "{\"id\":6,\"method\":\"send_input\",\"params\":{\"agentId\":\"agent-2\",\"text\":\"\",\"enter\":true}}",
      "expected": {
        "id": 6,
        "method": "send_input",
        "params": {
          "agentId": "agent-2",
          "text": "",
          "enter": true
        }
      }
    },
    {
      "name": "spawn with only the required fields",
      "raw": "{\"id\":7,\"method\":\"spawn\",\"params\":{\"projectPath\":\"/tmp/example-project\",\"prompt\":\"run the tests\"}}",
      "expected": {
        "id": 7,
        "method": "spawn",
        "params": {
          "projectPath": "/tmp/example-project",
          "prompt": "run the tests",
          "provider": null,
          "model": null,
          "permissionMode": null,
          "headless": null,
          "name": null,
          "role": null,
          "worktree": null
        }
      }
    },
    {
      "name": "kill",
      "raw": "{\"id\":8,\"method\":\"kill\",\"params\":{\"agentId\":\"agent-3\"}}",
