  "projectDescription": {
    "_comment": "How Rust derives ProjectEntry.description and descriptionSource. A description the user set on a starred project wins; otherwise a pure function over file contents. The cases are run by the Rust tests (the TS side only validates the shape).",
    "maxChars": 200,
    "cases": [
      {
        "name": "a user description wins over the README",
        "user": "Customer portal; ask before touching billing.",
        "readme": "# Portal\n\nSomething else.\n",
        "packageJson": null,
        "cargoToml": null,
        "expected": "Customer portal; ask before touching billing.",
        "expectedSource": "user"
      },
      {
        "name": "a blank user description falls through to the README",
        "user": "   ",
        "readme": "# Portal\n\nFrom the README.\n",
        "packageJson": null,
        "cargoToml": null,
        "expected": "From the README.",
        "expectedSource": "readme"
      },
      {
        "name": "a user description is kept verbatim apart from trimming, even past maxChars",
        "user": "  xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  ",
        "readme": null,
        "packageJson": null,
        "cargoToml": null,
        "expected": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
        "expectedSource": "user"
      },
      {
        "name": "README: first paragraph after the title",
        "readme": "# Invoice Parser\n\nA small example service that parses invoices.\nIt runs nightly.\n\n## Setup\n",
        "packageJson": null,
        "cargoToml": null,
        "expected": "A small example service that parses invoices. It runs nightly.",
        "user": null,
        "expectedSource": "readme"
      },
      {
        "name": "README badges and HTML lines are skipped",
        "readme": "# X\n\n[![build](https://x/y.svg)](https://x)\n<p align=\"center\"><img src=\"logo.png\"></p>\n\nThe real description.\n",
        "packageJson": null,
        "cargoToml": null,
        "expected": "The real description.",
        "user": null,
        "expectedSource": "readme"
      },
      {
        "name": "no README paragraph falls back to package.json",
        "readme": "# Only a title\n",
        "packageJson": "{\"name\":\"x\",\"description\":\"From package.json\"}",
        "cargoToml": null,
        "expected": "From package.json",
        "user": null,
        "expectedSource": "package"
      },
      {
        "name": "then Cargo.toml",
        "readme": null,
        "packageJson": null,
        "cargoToml": "[package]\nname = \"x\"\ndescription = \"From Cargo\"\n",
        "expected": "From Cargo",
        "user": null,
        "expectedSource": "cargo"
      },
      {
        "name": "nothing found",
        "readme": null,
        "packageJson": "{\"name\":\"x\"}",
        "cargoToml": null,
        "expected": null,
        "user": null,
        "expectedSource": null
      },
      {
        "name": "markdown emphasis and links are flattened",
        "readme": "# T\n\nBuilds **fast** [docs](https://example.com/docs) with `pnpm`.\n",
        "packageJson": null,
        "cargoToml": null,
        "expected": "Builds fast docs with pnpm.",
        "user": null,
        "expectedSource": "readme"
      },
      {
        "name": "long text keeps whole words, at most maxChars including the ellipsis",
        "readme": "# T\n\nword word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word \n",
        "packageJson": null,
        "cargoToml": null,
        "expected": "word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word…",
        "user": null,
        "expectedSource": "readme"
      }
    ],
    "userMaxChars": 300,
    "sources": ["user", "readme", "package", "cargo"]
  }
}
