{
  "$comment": "Machine-checkable half of docs/design-supervisor-link.md (the Supervisor Control API). Rust reads it in supervisor_link tests, TypeScript in the settings. Change this first.",
  "protocol": 1,
  "socketFileName": "supervisor-link.sock",
  "policyFileName": "supervisor-link.json",
  "path": "/v1",
  "pollMs": 250,
  "pingSeconds": 30,
  "maxMessageBytes": 1048576,
  "limits": {
    "$comment": "Per IDE process. Clients are processes of the same user, so these guard against a misbehaving client, not an attacker. Over a limit the answer is the error code busy with the limit as reason.",
    "maxConnections": 16,
    "maxPendingRequests": 64,
    "handshakeTimeoutSeconds": 10,
    "writeTimeoutSeconds": 10
  },
  "methods": [
    "session.hello",
    "supervisors.spawn",
    "agents.list",
    "agents.read",
    "agents.send",
    "agents.kill",
    "events.subscribe",
    "events.unsubscribe",
    "documents.projects",
    "documents.search",
    "documents.get",
    "documents.resolve",
    "documents.asset",
    "documents.propose",
    "jobs.create",
    "jobs.list",
    "jobs.cancel"
  ],
  "events": [
    "agent.added",
    "agent.updated",
    "agent.removed",
    "agent.output",
    "job.started",
    "job.progress",
    "job.finished",
    "job.failed"
  ],
  "supervisorProviders": ["claude", "codex"],
  "errorCodes": [
    "invalid_request",
    "unsupported_version",
    "unknown_method",
    "invalid_params",
    "forbidden_agent_caller",
    "unknown_agent",
    "agent_not_running",
    "headless_no_stdin",
    "supervisor_unavailable",
    "provider_denied",
    "provider_unsupported",
    "frontend_unavailable",
    "document_not_visible",
    "document_not_found",
    "document_invalid",
    "document_conflict",
    "not_a_git_repo",
    "supervisor_denied",
    "job_kind_not_allowed",
    "quota_exceeded",
    "unknown_job",
    "busy",
    "internal"
  ],
  "messages": [
    {
      "name": "a valid request without params",
      "line": "{\"v\":1,\"id\":\"a\",\"method\":\"agents.list\"}",
      "accepted": true
    },
    {
      "name": "a numeric id is echoed",
      "line": "{\"v\":1,\"id\":7,\"method\":\"session.hello\",\"params\":{\"client\":\"example-client\"}}",
      "accepted": true
    },
    {
      "name": "another version",
      "line": "{\"v\":2,\"id\":\"a\",\"method\":\"agents.list\"}",
      "error": "unsupported_version",
      "id": "a"
    },
    {
      "name": "no version at all",
      "line": "{\"id\":\"a\",\"method\":\"agents.list\"}",
      "error": "unsupported_version",
      "id": "a"
    },
    {
      "name": "not JSON",
      "line": "hello",
      "error": "invalid_request",
      "id": null
    },
    {
      "name": "an object id is refused, not answered as null",
      "line": "{\"v\":1,\"id\":{\"n\":1},\"method\":\"agents.list\"}",
      "error": "invalid_request",
      "id": null
    },
    {
      "name": "an array id is refused",
      "line": "{\"v\":1,\"id\":[1],\"method\":\"agents.list\"}",
      "error": "invalid_request",
      "id": null
    },
    {
      "name": "a boolean id is refused",
      "line": "{\"v\":1,\"id\":true,\"method\":\"agents.list\"}",
      "error": "invalid_request",
      "id": null
    },
    {
      "name": "no method",
      "line": "{\"v\":1,\"id\":3}",
      "error": "invalid_request",
      "id": 3
    },
    {
      "name": "an unknown method",
      "line": "{\"v\":1,\"id\":3,\"method\":\"files.read\",\"params\":{}}",
      "error": "unknown_method",
      "id": 3
    },
    {
      "name": "a control.sock method name is not a link method",
      "line": "{\"v\":1,\"id\":3,\"method\":\"spawn\",\"params\":{}}",
      "error": "unknown_method",
      "id": 3
    },
    {
      "name": "an unknown param",
      "line": "{\"v\":1,\"id\":4,\"method\":\"agents.send\",\"params\":{\"agentId\":\"agent-1\",\"text\":\"hi\",\"enter\":true}}",
      "error": "invalid_params",
      "id": 4
    },
    {
      "name": "a missing param",
      "line": "{\"v\":1,\"id\":5,\"method\":\"agents.kill\",\"params\":{}}",
      "error": "invalid_params",
      "id": 5
    },
    {
      "name": "tailBytes out of range",
      "line": "{\"v\":1,\"id\":8,\"method\":\"agents.read\",\"params\":{\"agentId\":\"agent-1\",\"tailBytes\":999999999}}",
      "error": "invalid_params",
      "id": 8
    },
    {
      "name": "propose without baseHash",
      "line": "{\"v\":1,\"id\":6,\"method\":\"documents.propose\",\"params\":{\"project\":\"/p\",\"type\":\"diagram\",\"id\":\"docs/a.diagram.json\",\"document\":{}}}",
      "error": "invalid_params",
      "id": 6
    },
    {
      "name": "propose a new document",
      "line": "{\"v\":1,\"id\":6,\"method\":\"documents.propose\",\"params\":{\"project\":\"/p\",\"type\":\"diagram\",\"id\":\"docs/a.diagram.json\",\"document\":{},\"baseHash\":null}}",
      "accepted": true
    },
    {
      "name": "get needs the document type",
      "line": "{\"v\":1,\"id\":7,\"method\":\"documents.get\",\"params\":{\"project\":\"/p\",\"id\":\"docs/a.diagram.json\"}}",
      "error": "invalid_params",
      "id": 7
    },
    {
      "name": "the old scene method is gone",
      "line": "{\"v\":1,\"id\":9,\"method\":\"scenes.get\",\"params\":{}}",
      "error": "unknown_method",
      "id": 9
    },
    {
      "name": "create a job",
      "line": "{\"v\":1,\"id\":10,\"method\":\"jobs.create\",\"params\":{\"project\":\"/p\",\"kind\":\"diagram.draw\",\"payload\":{\"focus\":\"auth\"}}}",
      "accepted": true
    },
    {
      "name": "a job without payload",
      "line": "{\"v\":1,\"id\":11,\"method\":\"jobs.create\",\"params\":{\"project\":\"/p\",\"kind\":\"diagram.draw\"}}",
      "error": "invalid_params",
      "id": 11
    },
    {
      "name": "a client cannot pick the model",
      "line": "{\"v\":1,\"id\":12,\"method\":\"jobs.create\",\"params\":{\"project\":\"/p\",\"kind\":\"k\",\"payload\":null,\"model\":\"big\"}}",
      "error": "invalid_params",
      "id": 12
    },
    {
      "name": "a payload over the limit",
      "line": "{\"v\":1,\"id\":13,\"method\":\"jobs.create\",\"params\":{\"project\":\"/p\",\"kind\":\"k\",\"payload\":\"\"}}",
      "error": "invalid_params",
      "id": 13
    },
    {
      "name": "cancel needs a jobId",
      "line": "{\"v\":1,\"id\":14,\"method\":\"jobs.cancel\",\"params\":{}}",
      "error": "invalid_params",
      "id": 14
    },
    {
      "name": "list running jobs of one project",
      "line": "{\"v\":1,\"id\":15,\"method\":\"jobs.list\",\"params\":{\"project\":\"/p\",\"status\":\"running\"}}",
      "accepted": true
    },
    {
      "name": "list jobs with an unknown status",
      "line": "{\"v\":1,\"id\":16,\"method\":\"jobs.list\",\"params\":{\"status\":\"done\"}}",
      "error": "invalid_params",
      "id": 16
    },
    {
      "name": "subscribe without job events",
      "line": "{\"v\":1,\"id\":17,\"method\":\"events.subscribe\",\"params\":{\"jobs\":false}}",
      "accepted": true
    }
  ],
  "resolve": [
    {
      "name": "relative to the folder, suffix added",
      "from": "docs/architecture/system.diagram.json",
      "ref": "modules/auth",
      "candidates": ["docs/architecture/modules/auth.diagram.json"]
    },
    {
      "name": "explicit ./",
      "from": "docs/architecture/system.diagram.json",
      "ref": "./modules/auth.diagram.json",
      "candidates": ["docs/architecture/modules/auth.diagram.json"]
    },
    {
      "name": "up one folder",
      "from": "docs/architecture/system.diagram.json",
      "ref": "../overview",
      "candidates": ["docs/overview.diagram.json"]
    },
    {
      "name": "from the root as a second guess",
      "from": "docs/architecture/system.diagram.json",
      "ref": "docs/other/thing",
      "candidates": [
        "docs/architecture/docs/other/thing.diagram.json",
        "docs/other/thing.diagram.json"
      ]
    },
    {
      "name": "leaves the project",
      "from": "docs/system.diagram.json",
      "ref": "../../x",
      "error": "invalid_params"
    },
    {
      "name": "leaves the type",
      "from": "docs/system.diagram.json",
      "ref": "../src/x",
      "error": "invalid_params"
    },
    {
      "name": "empty",
      "from": "docs/system.diagram.json",
      "ref": "",
      "error": "invalid_params"
    },
    {
      "name": "absolute",
      "from": "docs/system.diagram.json",
      "ref": "/etc/passwd",
      "error": "invalid_params"
    }
  ],
  "search": {
    "defaultLimit": 50,
    "maxLimit": 200,
    "maxDepth": 8,
    "maxFilesPerProject": 2000
  },
  "proposalBranchPrefix": "auric/proposal/",
  "policyVersion": 2,
  "documentIds": {
    "$comment": "Ids against the test type diagram (globs docs/**/*.diagram.json).",
    "valid": [
      "docs/system.diagram.json",
      "docs/architecture/system.diagram.json",
      "docs/a.b/c_d.diagram.json"
    ],
    "invalid": [
      "",
      "docs",
      "docs/system",
      "/docs/system.diagram.json",
      "docs/../secret.diagram.json",
      "docs/./system.diagram.json",
      "docs//system.diagram.json",
      "docs/.hidden.diagram.json",
      "src/system.diagram.json",
      "docs/system.json",
      "docs/a\\b.diagram.json"
    ]
  },
  "globs": {
    "match": [
      {
        "pattern": "docs/**/*.diagram.json",
        "path": "docs/a.diagram.json",
        "matches": true
      },
      {
        "pattern": "docs/**/*.diagram.json",
        "path": "docs/x/y/a.diagram.json",
        "matches": true
      },
      {
        "pattern": "docs/**/*.diagram.json",
        "path": "docs/a.json",
        "matches": false
      },
      {
        "pattern": "docs/**/*.diagram.json",
        "path": "src/docs/a.diagram.json",
        "matches": false
      },
      {
        "pattern": "docs/*.json",
        "path": "docs/x/a.json",
        "matches": false
      },
      {
        "pattern": "docs/?.json",
        "path": "docs/a.json",
        "matches": true
      },
      {
        "pattern": "docs/?.json",
        "path": "docs/ab.json",
        "matches": false
      },
      {
        "pattern": "**",
        "path": "any/thing.txt",
        "matches": true
      },
      {
        "pattern": "plan.json",
        "path": "plan.json",
        "matches": true
      }
    ],
    "invalid": ["docs//x.json", "docs/a**/x.json"]
  },
  "maxDocumentBytes": 262144,
  "maxIndexBytes": 4194304,
  "assets": {
    "$comment": "documents.asset: read-only bytes of files a document type lists under `assets` (project-relative globs). The file and the path it resolves to must both match; size is capped per type by maxAssetBytes.",
    "defaultMaxAssetBytes": 2097152,
    "maxAssetBytes": 16777216,
    "encoding": "base64"
  },
  "revs": {
    "$comment": "documents.get / documents.resolve rev: a commit id or a branch or tag name. Leading '-', revision expressions and anything git does not take as a ref name are invalid_params before git sees them.",
    "maxLength": 255,
    "valid": [
      "HEAD",
      "main",
      "auric/proposal/system-1a2b3c4d",
      "v1.2.0",
      "3f2c9a1",
      "refs/heads/main",
      "release_2026-10"
    ],
    "invalid": [
      "",
      "-n",
      "--output=/tmp/x",
      "HEAD~1",
      "HEAD^",
      "main@{1}",
      "@{-1}",
      ":/fix",
      "HEAD:docs/a.json",
      "a..b",
      "a b",
      "x.lock",
      "/main",
      "main/",
      ".hidden",
      "a\\b",
      "ma\u0000in"
    ]
  },
  "migration": {
    "$comment": "Version 1 of the policy file listed projects under scenes.projects. Each becomes a project with this one document type.",
    "v1DocumentType": {
      "name": "scene",
      "globs": ["docs/**/*.scene.json"],
      "index": {
        "path": "docs/scenes.index.json",
        "entriesKey": "scenes"
      },
      "nameField": "hud.title",
      "descriptionField": "hud.subtitle"
    }
  },
  "policyRejects": [
    {
      "name": "a type without globs",
      "config": {
        "documentTypes": [
          {
            "name": "t",
            "globs": []
          }
        ]
      },
      "mentions": "no globs"
    },
    {
      "name": "a glob that leaves the project",
      "config": {
        "documentTypes": [
          {
            "name": "t",
            "globs": ["../x/*.json"]
          }
        ]
      },
      "mentions": "project-relative glob"
    },
    {
      "name": "an absolute glob",
      "config": {
        "documentTypes": [
          {
            "name": "t",
            "globs": ["/etc/*.json"]
          }
        ]
      },
      "mentions": "project-relative glob"
    },
    {
      "name": "two types of one name",
      "config": {
        "documentTypes": [
          {
            "name": "t",
            "globs": ["a/*.json"]
          },
          {
            "name": "t",
            "globs": ["b/*.json"]
          }
        ]
      },
      "mentions": "unique"
    },
    {
      "name": "an uppercase kind",
      "config": {
        "jobKinds": [
          {
            "kind": "Draw",
            "instructions": "x.md",
            "writes": ["a/*"]
          }
        ]
      },
      "mentions": "unique lowercase"
    },
    {
      "name": "instructions outside the project",
      "config": {
        "jobKinds": [
          {
            "kind": "draw",
            "instructions": "../x.md",
            "writes": ["a/*"]
          }
        ]
      },
      "mentions": "instructions"
    },
    {
      "name": "a kind that may write nothing",
      "config": {
        "jobKinds": [
          {
            "kind": "draw",
            "instructions": "x.md"
          }
        ]
      },
      "mentions": "may write nothing"
    },
    {
      "name": "an asset glob that leaves the project",
      "config": {
        "documentTypes": [
          {
            "name": "t",
            "globs": ["a/*.json"],
            "assets": ["../x/*.glb"]
          }
        ]
      },
      "mentions": "project-relative glob"
    },
    {
      "name": "an asset cap above the maximum",
      "config": {
        "documentTypes": [
          {
            "name": "t",
            "globs": ["a/*.json"],
            "assets": ["a/*.glb"],
            "maxAssetBytes": 16777217
          }
        ]
      },
      "mentions": "maxAssetBytes"
    },
    {
      "name": "an asset cap of zero",
      "config": {
        "documentTypes": [
          {
            "name": "t",
            "globs": ["a/*.json"],
            "assets": ["a/*.glb"],
            "maxAssetBytes": 0
          }
        ]
      },
      "mentions": "maxAssetBytes"
    }
  ],
  "jobs": {
    "$comment": "jobs.create: the runaway counter, the register and the job vocabulary.",
    "fileName": "supervisor-link-jobs.json",
    "defaultDailyLimit": 20,
    "maxDailyLimit": 1000,
    "windowHours": 24,
    "maxPayloadBytes": 16384,
    "listDefaultLimit": 50,
    "listMaxLimit": 200,
    "tickMs": 2000,
    "statuses": ["running", "finished", "failed"],
    "errorCodes": [
      "agent_failed",
      "no_changes",
      "document_invalid",
      "cancelled",
      "interrupted",
      "internal"
    ],
    "quota": [
      {
        "name": "room left",
        "limits": {
          "dailyLimit": 20,
          "perProjectDailyLimit": null
        },
        "inWindow": 19,
        "inProject": 19
      },
      {
        "name": "the daily limit is reached",
        "limits": {
          "dailyLimit": 20,
          "perProjectDailyLimit": null
        },
        "inWindow": 20,
        "inProject": 3,
        "reason": "daily_limit"
      },
      {
        "name": "zero switches jobs off",
        "limits": {
          "dailyLimit": 0,
          "perProjectDailyLimit": null
        },
        "inWindow": 0,
        "inProject": 0,
        "reason": "disabled"
      },
      {
        "name": "a project limit of zero switches jobs off there",
        "limits": {
          "dailyLimit": 20,
          "perProjectDailyLimit": 0
        },
        "inWindow": 0,
        "inProject": 0,
        "reason": "disabled"
      },
      {
        "name": "the project limit is reached first",
        "limits": {
          "dailyLimit": 20,
          "perProjectDailyLimit": 5
        },
        "inWindow": 7,
        "inProject": 5,
        "reason": "project_daily_limit"
      },
      {
        "name": "another project's jobs do not count against this one",
        "limits": {
          "dailyLimit": 20,
          "perProjectDailyLimit": 5
        },
        "inWindow": 12,
        "inProject": 4
      }
    ]
  }
}
